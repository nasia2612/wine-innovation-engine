install.packages("rsm")
installed.packages("rsm")
library(rsm)
design <- read.csv("results/phase3_doe/design_matrix.csv")
head(design)
str(design)
design$reached_dryness<-as.logical(design$reached_dryness)
design$reached_practical_end<-as.logical(design$reached_practical_end)
design_clean<-design[,!(names(design) %in% c("x1", "x2", "x3"))]
design_coded <- coded.data(design_clean,
x1 ~ (Ti - 21)/6,
x2 ~ (Sub0 - 265)/15,
x3 ~ (N0 - 240)/100
)
#lets fit
model_peak<-rsm(peak_rate~SO(x1,x2,x3),data=design_coded)
View(design)
View(model_peak)
summary(model_peak)
View(design)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_peak,~x1+x2+x3,
image=TRUE)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_peak,~x1+x2+x3,
image=TRUE)
#IT FREEZES AT Substrate=265 ,we took only x1 and x3 because these interactions are important
contour(model_peak,x1~x3,at=list(x2=0),image=TRUE)
#we add the real points
points(design_coded$x1,design_coded$x3,pch=19)
par(mfrow=c(1,3))
contour(model_peak,~x1+x2+x3,
image=TRUE)
#lets fit
model_peak<-rsm(peak_rate~SO(x1,x2,x3),data=design_coded)
summary(model_peak)
#we fit a second-order model that makes 9 linear (x1,x2,x3)  3 interactions (x1x2, x1x3, x2x3), 3 pure quadratic (x1², x2², x3²)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_peak,~x1+x2+x3,
image=TRUE)
#IT FREEZES AT Substrate=265 ,we took only x1 and x3 because these interactions are important
contour(model_peak,x1~x3,at=list(x2=0),image=TRUE)
#we add the real points
points(design_coded$x1,design_coded$x3,pch=19)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_peak,~x1+x2+x3,
image=TRUE)
#IT FREEZES AT Substrate=265 ,we took only x1 and x3 because these interactions are important
contour(model_peak,x1~x3,at=list(x2=0),image=TRUE)
#we add the real points
points(design_coded$x1,design_coded$x3,pch=19)
contour(model_peak,x1~x3,at=list(x2=1),image=TRUE)
#we add the real points
points(design_coded$x1,design_coded$x3,pch=19)
#IT FREEZES AT Substrate=265 ,we took only x1 and x3 because these interactions are important
contour(model_peak,x1~x3,at=list(x2=-1),image=TRUE)
#we add the real points
points(design_coded$x1,design_coded$x3,pch=19)
persp(model_peak,x1~x3,col="steelblue",contours = "colors")
persp(model_peak,x1~x3,at=list(x2=-1),col="steelblue",contours = "colors")
persp(model_peak,x1~x3,at=list(x2=1),col="steelblue",contours = "colors")
persp(model_peak,x1~x3,at=list(x2=1),col=terrain.colors(50),contours = "colors")
persp(model_peak,x1~x3,at=list(x2=0),col=terrain.colors(50),contours = "colors")
persp(model_peak,x1~x3,at=list(x2=-1),col=terrain.colors(50),contours = "colors")
library(rsm)
design <- read.csv("results/phase3_doe/design_matrix.csv")
head(design)
str(design)
#fix the strings in reached dryness and reached practical to boolean
design$reached_dryness<-as.logical(design$reached_dryness)
design$reached_practical_end<-as.logical(design$reached_practical_end)
#lets fit FOR time
model_time<-rsm(time~SO(x1,x2,x3),data=design_coded)
summary(model_time)
View(model_time)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_time,~x1+x2+x3,
image=TRUE)
model_conversion<-rsm(conversion~SO(x1,x2,x3),data=design_coded)
summary(model_conversion)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_conversion,~x1+x2+x3,
image=TRUE)
#lets fit FOR ethanol
model_ethanol<-rsm(ethanol~SO(x1,x2,x3),data=design_coded)
summary(model_ethanol)
#countour /perspective plots
par(mfrow=c(1,3))
contour(model_ethanol,~x1+x2+x3,
image=TRUE)
library(desirability)
install.packages("desirability")
library(desirability)
range(desing_coded$time)
range(design_coded$time)
range(design_coded$peak_rate)
range(design_coded$conversion)
library(desirability)
range(design_coded$time)
range(design_coded$peak_rate)
range(design_coded$conversion)
#desirability functions
d_time <- dMin(low = 106.5533, high = 811.9060)
d_peak_rate<-dMin(low=0.8516844,high=4.0315215)
d_conv <- dMax(low = 0.98, high = 0.99)
predict(d_time, 811.91)
predict(d_time, 106.55)
predict(d_conv, 0.8267)
predict(d_conv, 1.0)
View(d_time)
predict(d_peak_rate, 4.0315215)
