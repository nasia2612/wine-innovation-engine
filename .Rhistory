library(rsm)
design <- read.csv("/home/nasia/wine-innovation-engine/results/phase3_doe/design_matrix.csv")
head(design)
str(design)
design$reached_dryness <- as.logical(design$reached_dryness)
design$reached_practical_end <- as.logical(design$reached_practical_end)
design_clean <- design[, !(names(design) %in% c("x1", "x2", "x3"))]
design_coded <- coded.data(design_clean,
x1 ~ (Ti - 21) / 6,
x2 ~ (Sub0 - 265) / 15,
x3 ~ (N0 - 240) / 100
)
model_peak <- rsm(peak_rate ~ SO(x1, x2, x3), data = design_coded)
summary(model_peak)
par(mfrow = c(1, 3))
contour(model_peak, ~x1 + x2 + x3, image = TRUE)
contour(model_peak, x1 ~ x3, at = list(x2 = -1), image = TRUE)
points(design_coded$x1, design_coded$x3, pch = 19)
persp(model_peak, x1 ~ x3, at = list(x2 = -1), col = terrain.colors(50), contours = "colors")
model_time <- rsm(time ~ SO(x1, x2, x3), data = design_coded)
summary(model_time)
par(mfrow = c(1, 3))
contour(model_time, ~x1 + x2 + x3, image = TRUE)
model_conversion <- rsm(conversion ~ SO(x1, x2, x3), data = design_coded)
summary(model_conversion)
par(mfrow = c(1, 3))
contour(model_conversion, ~x1 + x2 + x3, image = TRUE)
model_ethanol <- rsm(ethanol ~ SO(x1, x2, x3), data = design_coded)
summary(model_ethanol)
par(mfrow = c(1, 3))
contour(model_ethanol, ~x1 + x2 + x3, image = TRUE)
install.packages("desirability")
library(desirability)
range(design_coded$time)
range(design_coded$peak_rate)
range(design_coded$conversion)
#desirability functions
d_time <- dMin(low = min(design_coded$time), high = max(design_coded$time))
d_peak_rate<-dMin(low=min(design_coded$peak_rate),high=max(design_coded$peak_rate))
d_conv <- dMax(low =0.98, high = 0.99)#it is a constraint not optimization target
predict(d_time, 811.91)
predict(d_time, 106.55)
predict(d_conv, 0.8267)
predict(d_conv, 1.0)
predict(d_peak_rate, 4.0315215) #we dont want it high because it needs more cooling
#the contatiner it keeps the three of them
overall<-dOverall(d_time,d_conv,d_peak_rate) #it uses geometric mean because everything we want acceptable
rsmOpt<-function(x,x0bject){
newdata<-data.frame(x1=x[1],x)
}
# Πρόβλεψε responses στο σημείο x = (x1, x2, x3)
newdata <- data.frame(x1 = x[1], x2 = x[2], x3 = x[3])
pred_time <- predict(model_time,       newdata)
pred_peak <- predict(model_peak,       newdata)
#the contatiner it keeps the three of them
overall<-dOverall(d_time,d_conv,d_peak_rate) #it uses geometric mean because everything we want acceptable
